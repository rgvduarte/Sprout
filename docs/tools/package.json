{
  "name": "sprout-doc-tools",
  "private": true,
  "version": "0.1.0",
  "description": "Ferramentas partilhadas dos documentos do Sprout: HTML + print.css -> PDF (Playwright/Chromium), gráficos SVG e pré-visualização das páginas.",
  "type": "module",
  "scripts": {
    "pdf": "node render-pdf.mjs",
    "preview": "python3 preview.py",
    "resumo": "node render-pdf.mjs ../resumo/resumo.html ../resumo/Sprout-Resumo-Executivo.pdf && python3 preview.py ../resumo/Sprout-Resumo-Executivo.pdf"
  },
  "dependencies": {
    "@fontsource-variable/archivo": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@fontsource/public-sans": "5.3.0",
    "playwright": "1.56.1"
  }
}
